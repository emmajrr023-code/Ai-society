# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# SERVER ONLY. Never expose this key in browser code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Owner-only admin secret. Use a long random value (32+ bytes).
ADMIN_SECRET=

# Vercel Cron authentication secret. Set the same value in Vercel.
CRON_SECRET=

# OpenAI-compatible model provider (provider API usage may be billed).
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini
